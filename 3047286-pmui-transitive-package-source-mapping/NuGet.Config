<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <add key="globalPackagesFolder" value=".\cache\packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget-division" value=".\feeds\nuget-division" />
    <add key="nuget-company" value=".\feeds\nuget-company" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget-division">
      <package pattern="Company.Division.*" />
    </packageSource>
    <packageSource key="nuget-company">
      <package pattern="Company.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
